  "implementation_steps": [
    "1. Install Dependencies: expo-blur, expo-linear-gradient, @expo/vector-icons, react-native-reanimated, expo-font, firebase.",
    "2. Setup Contexts: Create ThemeContext to handle theme switching (Space/Sunset/Dark/Light).",
    "3. Create Layout: Use Stack from expo-router. Create a layout wrapper that applies the background gradient.",
    "4. Build Components: Implement GlassView, CandyButton, InputField (Glass style).",
    "5. Auth Screen: Glass panel centered. Nickname input + Code verification.",
    "6. Main Screen: Tab Navigation (Chats, Profile, Settings). FAB with animation.",
    "7. Chat Screen: FlatList for messages. Input bar with Glass effect.",
    "8. Integrate Logic: Connect to Firebase Realtime Database for chat sync.",
    "9. Animations: Add 'Candy Spinner' on splash and 'Message Pop' on new messages using Reanimated."
  ],
  "universal_guidelines": [
    "NO AI SLOP: Do not use generic 'Inter' font. Use Montserrat as requested.",
    "GLASSMORPHISM: Blur intensity must be visible (20-50). Do not make it opaque.",
    "CONTRAST: Ensure text is readable on glass. Use text shadows if necessary.",
    "AESTHETIC: Keep it 'Sweet'. Use rounded corners (20px+).",
    "ANIMATION: Everything must pop. Buttons scale on press. Lists fade in.",
    "DATA-TESTID: Add 'data-testid' to all interactive elements for testing."
  ]
}