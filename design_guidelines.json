  "component_guidelines": {
    "GlassContainer": {
      "description": "Base container for cards and panels",
      "style": {
        "borderRadius": 24,
        "borderWidth": 1,
        "overflow": "hidden"
      },
      "implementation": "Use expo-blur (BlurView) with intensity=25-50. Wrap inside a View with borderColor."
    },
    "CandyButton": {
      "description": "Primary action button with sweet aesthetic",
      "style": {
        "borderRadius": 16,
        "padding": 14,
        "shadowColor": "primary_color",
        "shadowOffset": { "width": 0, "height": 4 },
        "shadowOpacity": 0.3,
        "shadowRadius": 5,
        "elevation": 5
      },
      "implementation": "Use TouchableOpacity. Background should be the Theme Primary color. Text White Bold."
    },
    "ChatBubble": {
      "description": "Message bubble with glass or gradient effect",
      "style": {
        "borderRadius": 18,
        "padding": 12,
        "maxWidth": "80%"
      },
      "variants": {
        "in": "Glass background (theme.message_in), alignLeft, borderBottomLeftRadius: 4",
        "out": "Gradient/Color background (theme.message_out), alignRight, borderBottomRightRadius: 4"
      }
    },
    "SecretCode": {
      "description": "Blurred text that reveals on tap",
      "style": {
        "fontFamily": "monospace",
        "letterSpacing": 8,
        "fontSize": 32
      },
      "interaction": "Toggle blur on press. Use state 'isRevealed'."
    },
    "Avatar": {
      "description": "User profile picture with status",
      "style": {
        "width": 50,
        "height": 50,
        "borderRadius": 25,
        "borderWidth": 1,
        "borderColor": "rgba(255,255,255,0.2)"
      },
      "status_indicator": "Green dot (12x12) with white border at bottom-right"
    }
  },
